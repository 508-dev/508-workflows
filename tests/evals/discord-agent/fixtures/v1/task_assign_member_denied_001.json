{
  "version": "discord-agent-trajectory.v1",
  "id": "task_assign_member_denied_001",
  "description": "Members cannot reassign tasks because assignment requires task:assign in addition to task:update_own.",
  "tags": ["weekly", "task", "policy", "denied"],
  "suite": {
    "canonical": true,
    "weekly": true
  },
  "context": {
    "discord_user_id": "123",
    "organization_id": "org-1",
    "guild_id": "org-1",
    "roles": ["Member"]
  },
  "request": {
    "message": "Assign TASK-001 to Sarah"
  },
  "expect": {
    "status": "denied",
    "intent": "update_task",
    "model_tier": "strong",
    "requires_confirmation": false,
    "message_contains": "task:assign",
    "actions": [
      {
        "tool_name": "task_write.update_task",
        "requires_confirmation": false,
        "required_scopes": ["task:update_own", "task:assign"],
        "arguments_contains": {
          "task_id": "TASK-001",
          "assignee": "Sarah"
        }
      }
    ]
  }
}
