{
  "version": "discord-agent-trajectory.v1",
  "id": "task_create_mentions_github_issue_001",
  "description": "Explicit task creation wins even when the task title mentions a GitHub issue.",
  "tags": ["canonical", "task", "write", "routing"],
  "suite": {
    "canonical": true,
    "weekly": true
