{
  "version": "discord-agent-trajectory.v1",
  "id": "github_todo_member_confirmation_001",
  "description": "A Discord Member can create a confirmed todo in the built-in sentinel repository.",
  "tags": ["canonical", "github", "todo", "member", "confirmation"],
  "suite": {
    "canonical": true,
    "weekly": true
  },
  "context": {
    "discord_user_id": "123",
    "organization_id": "org-1",
